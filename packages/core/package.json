{
  "name": "@nikovirtala/draft-core",
  "version": "0.0.0",
  "private": true,
  "description": "draft's domain: addresses, events, the log, projections, references, resolvers and the agent interface. No Electron.",
  "type": "module",
  "engines": {
    "node": ">=24.15"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./view": {
      "source": "./src/view.ts",
      "types": "./dist/view.d.ts",
      "default": "./dist/view.js"
    },
    "./map-graph": {
      "source": "./src/map-graph.ts",
      "types": "./dist/map-graph.d.ts",
      "default": "./dist/map-graph.js"
    },
    "./map-layout": {
      "source": "./src/map-layout.ts",
      "types": "./dist/map-layout.d.ts",
      "default": "./dist/map-layout.js"
    },
    "./map-labels": {
      "source": "./src/map-labels.ts",
      "types": "./dist/map-labels.d.ts",
      "default": "./dist/map-labels.js"
    },
    "./map-viewport": {
      "source": "./src/map-viewport.ts",
      "types": "./dist/map-viewport.d.ts",
      "default": "./dist/map-viewport.js"
    },
    "./map-types": {
      "source": "./src/map-types.ts",
      "types": "./dist/map-types.d.ts",
      "default": "./dist/map-types.js"
    },
    "./testing": {
      "source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/testing/kiro-remote-tools.json','dist/testing/kiro-remote-tools.json')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@opentelemetry/api": "1.10.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "3.1.1",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-logs": "3.1.1",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "@opentelemetry/sdk-trace": "3.1.1"
  }
}
