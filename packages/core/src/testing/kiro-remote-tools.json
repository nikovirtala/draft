{
  "tools": [
    {
      "name": "kiro_capabilities",
      "description": "Report the control plane's advertised capabilities, the kiro-cli version, and the caller's active cloud-session count.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {}
      },
      "annotations": {
        "title": "Capabilities",
        "readOnlyHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "kiro_list_models",
      "description": "List the model ids the running agent advertises.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {}
      },
      "annotations": {
        "title": "List Models",
        "readOnlyHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "kiro_launch_session",
      "description": "Launch a new Kiro cloud session against one or more repos with an initial prompt.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "repos": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[^/\\s]+\\/[^/\\s]+$"
            }
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "effort": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["prompt", "repos"]
      },
      "annotations": {
        "title": "Launch Session",
        "readOnlyHint": false,
        "openWorldHint": true
      }
    },
    {
      "name": "kiro_list_sessions",
      "description": "List the caller's sessions, newest first, with an optional status filter and pagination cursor.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "status": {
            "anyOf": [
              {
                "type": "string",
                "const": "provisioning"
              },
              {
                "type": "string",
                "const": "running"
              },
              {
                "type": "string",
                "const": "idle"
              },
              {
                "type": "string",
                "const": "awaiting_permission"
              },
              {
                "type": "string",
                "const": "failed"
              },
              {
                "type": "string",
                "const": "deleted"
              }
            ]
          },
          "limit": {
            "default": 20,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "cursor": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "annotations": {
        "title": "List Sessions",
        "readOnlyHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "kiro_adopt_session",
      "description": "Adopt an existing Kiro cloud session (started elsewhere) into the control plane.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "kiroSessionId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["kiroSessionId"]
      },
      "annotations": {
        "title": "Adopt Session",
        "readOnlyHint": false,
        "openWorldHint": true
      }
    },
    {
      "name": "kiro_get_session",
      "description": "Fetch a single session the caller owns.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["sessionId"]
      },
      "annotations": {
        "title": "Get Session",
        "readOnlyHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "kiro_send_prompt",
      "description": "Send a prompt to a session, steering, queueing, or rejecting it when the session is busy.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "whenBusy": {
            "default": "steer",
            "anyOf": [
              {
                "type": "string",
                "const": "steer"
              },
              {
                "type": "string",
                "const": "queue"
              },
              {
                "type": "string",
                "const": "reject"
              }
            ]
          },
          "sessionId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["prompt", "sessionId"]
      },
      "annotations": {
        "title": "Send Prompt",
        "readOnlyHint": false,
        "openWorldHint": true
      }
    },
    {
      "name": "kiro_wait_for_events",
      "description": "Long-poll a session's event log (at most 20s). Returns at most 30 events and 8000 chars of text, reports truncation, and includes nextCursor, turnStatus, and the pending-permission count so an agent can poll cheaply.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "after": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "types": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sessionId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["sessionId"]
      },
      "annotations": {
        "title": "Wait For Events",
        "readOnlyHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "kiro_get_transcript",
      "description": "Return the assistant's FINAL text for each completed turn in a session (not raw events).",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["sessionId"]
      },
      "annotations": {
        "title": "Get Transcript",
        "readOnlyHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "kiro_list_permissions",
      "description": "List a session's permission requests, optionally filtered by status (e.g. pending).",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["sessionId"]
      },
      "annotations": {
        "title": "List Permissions",
        "readOnlyHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "kiro_answer_permission",
      "description": "Answer a pending permission request by returning one of the agent-supplied optionIds (plus optional persistent consent).",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "optionId": {
            "type": "string",
            "minLength": 1
          },
          "consent": {
            "type": "object",
            "properties": {
              "scope": {
                "type": "string",
                "minLength": 1
              },
              "resource": {
                "type": "string",
                "minLength": 1
              },
              "workspaceRoot": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["scope", "resource", "workspaceRoot"]
          },
          "sessionId": {
            "type": "string",
            "minLength": 1
          },
          "requestId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["optionId", "sessionId", "requestId"]
      },
      "annotations": {
        "title": "Answer Permission",
        "readOnlyHint": false,
        "openWorldHint": true
      }
    },
    {
      "name": "kiro_set_config",
      "description": "Change a session's model, effort level, and/or mode.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1
          },
          "effort": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "type": "string",
            "minLength": 1
          },
          "sessionId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["sessionId"]
      },
      "annotations": {
        "title": "Set Config",
        "readOnlyHint": false,
        "openWorldHint": true
      }
    },
    {
      "name": "kiro_link_pull_request",
      "description": "Link a pull request (owner/repo#n or a github.com URL) to a session so GitHub activity on it wakes the session. The PR's repo must be one of the session's repos; a PR links to at most one session.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "pr": {
            "type": "string",
            "minLength": 1
          },
          "sessionId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["pr", "sessionId"]
      },
      "annotations": {
        "title": "Link Pull Request",
        "readOnlyHint": false,
        "openWorldHint": true
      }
    },
    {
      "name": "kiro_unlink_pull_request",
      "description": "Remove a pull request link from a session.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "pr": {
            "type": "string",
            "minLength": 1
          },
          "sessionId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["pr", "sessionId"]
      },
      "annotations": {
        "title": "Unlink Pull Request",
        "readOnlyHint": false,
        "openWorldHint": true
      }
    },
    {
      "name": "kiro_cancel_turn",
      "description": "Cancel the active turn on a session.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["sessionId"]
      },
      "annotations": {
        "title": "Cancel Turn",
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "kiro_delete_session",
      "description": "Permanently delete a session and its cloud sandbox.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["sessionId"]
      },
      "annotations": {
        "title": "Delete Session",
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": true
      }
    }
  ]
}
