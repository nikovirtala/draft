{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "customConditions": ["source"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"]
  },
  "include": [
    "src/main",
    "src/preload",
    "scripts",
    "src/shared",
    "test",
    "e2e",
    "build-info.ts",
    "electron.vite.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["test/renderer"]
}
