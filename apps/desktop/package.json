{
  "name": "@nikovirtala/draft-desktop",
  "version": "0.0.0",
  "private": true,
  "description": "draft's desktop app: one conversation, on Electron.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikovirtala/draft.git",
    "directory": "apps/desktop"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "palette:sync": "node scripts/sync-palette.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.8.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@nikovirtala/draft-core": "workspace:*",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.1.1",
    "@opentelemetry/exporter-logs-otlp-http": "0.301.2",
    "@opentelemetry/exporter-metrics-otlp-http": "0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-logs": "3.1.1",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.4.1",
    "electron-vite": "6.0.0",
    "mermaid": "12.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "vite": "8.3.8"
  }
}
