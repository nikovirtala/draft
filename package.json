{
  "name": "draft",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepare": "adr hooks install && issues hooks install",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check . && markdownlint-cli2",
    "format": "biome check --write .",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm --filter @nikovirtala/draft-desktop run test:e2e",
    "build": "pnpm -r run build",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "markdownlint-cli2": "0.24.2",
    "@nikovirtala/adr": "0.7.0",
    "@nikovirtala/issues": "0.7.0",
    "@types/node": "24.19.2",
    "fast-check": "4.10.3",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
